# DrugIntel Backend Configuration
# Copy this file to .env and fill in your values

# API Configuration
DEBUG=False
LOG_LEVEL=INFO

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/drugintel_db
SQLITE_URL=sqlite:///./drugintel.db

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production_2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/auth/callback

# Email Configuration (for OTP and notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM=noreply@drugintel.com

# SMS Configuration (for 2FA, optional)
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_token
TWILIO_FROM_NUMBER=+1234567890

# Security
HSM_ENABLED=False
HSM_MODULE_PATH=/usr/lib/softhsm/libsofthsm2.so
HSM_SLOT=0
HSM_PIN=1234

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://yourdomain.com

# File Upload
MAX_UPLOAD_SIZE_MB=10
UPLOAD_DIRECTORY=./uploads

# ML Models
MODEL_VERSION=v1.0
ML_MODEL_PATH=./ml_models/trained_models/

# External APIs
PUBCHEM_API_URL=https://pubchem.ncbi.nlm.nih.gov/rest/pug/
RDKIT_ENABLED=True

# Audit & Compliance
AUDIT_LOG_RETENTION_DAYS=2555  # ~7 years for compliance
ENABLE_AUDIT_EXPORT=True

# Sentry (Error tracking, optional)
SENTRY_DSN=

# Feature Flags
ENABLE_GOOGLE_OAUTH=True
ENABLE_MFA=True
ENABLE_PATIENT_SHARING=True
ENFORCE_EMAIL_VERIFICATION=True
